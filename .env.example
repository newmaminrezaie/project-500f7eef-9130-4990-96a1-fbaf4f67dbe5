# ---- Postgres ----
POSTGRES_USER=app
POSTGRES_PASSWORD=change_this_to_a_long_random_string
POSTGRES_DB=app

# ---- App session encryption (32+ characters, totally random) ----
# Generate with: openssl rand -hex 32
SESSION_SECRET=please_replace_with_a_long_random_string_at_least_32_chars

# ---- Two user accounts (created automatically on first boot) ----
OWNER_USERNAME=owner
OWNER_PASSWORD=change_me_owner_password
OWNER_NAME=مدیر

DAD_USERNAME=dad
DAD_PASSWORD=change_me_dad_password
DAD_NAME=پدر
